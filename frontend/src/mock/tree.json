  "sentences": [
    { "id": "l1",  "speaker": "S1", "text": "야 빨리 와",                 "start": 10.0,   "end": 11.2  },
    { "id": "l2",  "speaker": "S2", "text": "오늘 뭐 살 거야?",           "start": 38.5,   "end": 40.1  },
    { "id": "l3",  "speaker": "S1", "text": "그냥 과자 보고 결정하자",     "start": 40.5,   "end": 42.8  },
    { "id": "l88", "speaker": "S1", "text": "칼로리 보소",                "start": 355.2,  "end": 356.4 },
    { "id": "l89", "speaker": "S2", "text": "이거 하나에 600이야?",        "start": 358.0,  "end": 360.1 },
    { "id": "l90", "speaker": "S1", "text": "그냥 먹어 오늘은",            "start": 363.0,  "end": 364.5 },
    { "id": "l91", "speaker": "S2", "text": "이게 맛있나 저게 맛있나",     "start": 375.0,  "end": 377.3 },
    { "id": "l92", "speaker": "S1", "text": "어 이거 신상이다",            "start": 455.0,  "end": 456.8 },
    { "id": "l93", "speaker": "S2", "text": "카드 돼요?",                 "start": 655.0,  "end": 656.0 },
    { "id": "l94", "speaker": "S1", "text": "집 빨리 가자 배고파",         "start": 770.0,  "end": 772.0 },
    { "id": "l95", "speaker": "S1", "text": "일단 다 꺼내자",              "start": 950.0,  "end": 951.5 },
    { "id": "l96", "speaker": "S2", "text": "와 이게 다야?",               "start": 952.0,  "end": 953.5 },
    { "id": "l97", "speaker": "S1", "text": "먹어봐 진짜 맛있어",          "start": 1205.0, "end": 1207.0},
    { "id": "l98", "speaker": "S2", "text": "어 이거 생각보다 괜찮다",     "start": 1535.0, "end": 1537.5},
    { "id": "l99", "speaker": "S1", "text": "그치? 자꾸 손이 가",          "start": 1538.0, "end": 1540.0},
    { "id": "l100","speaker": "S1", "text": "오늘 영상 재밌었지?",         "start": 3430.0, "end": 3432.0}
  ],
