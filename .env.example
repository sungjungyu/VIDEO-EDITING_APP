# 이 파일을 .env로 복사해 값을 채운다 (.env는 git에 올라가지 않는다).
# 실제 환경 변수가 있으면 그것이 우선한다. 전체 목록은 src/vibecut/settings.py 참고.

GEMINI_API_KEY=

